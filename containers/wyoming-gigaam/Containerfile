# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS packages

ARG GIGAAM_REF=7447938d791c4f3e643386ee22c33777004293a5

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MODEL_DIR=/opt/models/gigaam \
    HF_HOME=/opt/models/huggingface \
    HF_HUB_CACHE=/opt/models/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
    && rm -rf /var/lib/apt/lists/*

COPY gigaam-loading.patch /tmp/gigaam-loading.patch

RUN python -m pip install --index-url https://download.pytorch.org/whl/cu126 \
      "torch==2.10.0+cu126" "torchaudio==2.10.0+cu126" "torchcodec==0.10.0+cu126"

RUN git clone --filter=blob:none https://github.com/salute-developers/GigaAM.git /tmp/GigaAM \
    && cd /tmp/GigaAM \
    && git checkout "${GIGAAM_REF}" \
    && git apply --unidiff-zero /tmp/gigaam-loading.patch \
    && python -m pip install ".[longform]" "wyoming==1.8.0" \
    && mkdir -p /usr/share/licenses/GigaAM \
    && cp /tmp/GigaAM/LICENSE /usr/share/licenses/GigaAM/LICENSE

FROM packages AS build

COPY download_models.py /tmp/download_models.py

RUN --mount=type=secret,id=HUGGING_FACE_TOKEN,required=true \
    python /tmp/download_models.py \
      --hf-token-file /run/secrets/HUGGING_FACE_TOKEN \
      --gigaam-dir "${MODEL_DIR}" \
      --hf-cache "${HF_HUB_CACHE}"

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    MODEL=multilingual_ctc \
    DEVICE=cuda \
    MODEL_DIR=/opt/models/gigaam \
    HF_HOME=/opt/models/huggingface \
    HF_HUB_CACHE=/opt/models/huggingface \
    URI=tcp://0.0.0.0:10300 \
    FR_BATCH_SIZE=1 \
    FR_NUM_WORKERS=0 \
    LONGFORM_THRESHOLD_SECONDS=25

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /opt/models /opt/models
COPY --from=build /usr/share/licenses/GigaAM /usr/share/licenses/GigaAM
COPY --from=build /usr/share/licenses/pyannote-segmentation-3.0 /usr/share/licenses/pyannote-segmentation-3.0
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/wyoming-gigaam/THIRD_PARTY_NOTICES.md

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY wyoming_server.py /app/wyoming_server.py

EXPOSE 10300

ENTRYPOINT ["python", "/app/wyoming_server.py"]
