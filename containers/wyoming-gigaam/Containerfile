# syntax=docker/dockerfile:1
FROM nvidia/cuda:13.4.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL=gigaam-multilingual-ctc \
    DEVICE=cuda \
    MODEL_CACHE_DIR=/models \
    VAD_DIR=/opt/models/vad \
    URI=tcp://0.0.0.0:10300 \
    FR_BATCH_SIZE=1 \
    LONGFORM_THRESHOLD_SECONDS=25

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      python3 \
      python3.12-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && python -m pip install "onnx-asr[hub]==0.12.0" "onnxruntime-gpu==1.20.2" "wyoming==1.8.0"

COPY download_models.py /tmp/download_models.py
COPY GIGAAM_LICENSE /usr/share/licenses/GigaAM/LICENSE
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/wyoming-gigaam/THIRD_PARTY_NOTICES.md

RUN python /tmp/download_models.py && rm /tmp/download_models.py

COPY wyoming_server.py /app/wyoming_server.py

EXPOSE 10300

ENTRYPOINT ["python", "/app/wyoming_server.py"]
