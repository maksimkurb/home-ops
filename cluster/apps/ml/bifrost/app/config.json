{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": true,
    "enforce_auth_on_inference": true,
    "allowed_origins": ["https://bifrost.${SECRET_PRIVATE_DOMAIN}","https://openwebui.${SECRET_PRIVATE_DOMAIN}"]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "providers": {
    "llama-cluster": {
      "keys": [
        {
          "name": "llama-cluster",
          "value": "env.LLAMA_CLUSTER_API_KEY",
          "models": ["ternary-bonsai-1.7b", "qwen3-embedding-0.6b", "home-gemma3-4b-ru"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://llama-cpp.ml.svc.cluster.local",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 600
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "text_completion": true,
          "text_completion_stream": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true,
          "count_tokens": true,
          "embedding": true
        }
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    },
    "virtual_keys": [
      {
        "id": "ml-clients",
        "name": "ML clients",
        "value": "env.BIFROST_API_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "llama-cluster",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "cluster-only",
        "name": "Cluster only",
        "priority": 1,
        "cel_expression": "model == 'cluster'",
        "targets": [
          {
            "provider": "llama-cluster",
            "model": "ternary-bonsai-1.7b",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "cluster-embedding",
        "name": "Cluster embedding",
        "priority": 3,
        "cel_expression": "model == 'embedding'",
        "targets": [
          {
            "provider": "llama-cluster",
            "model": "qwen3-embedding-0.6b",
            "weight": 1.0
          }
        ]
      }
    ]
  }
}
