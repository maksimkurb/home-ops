#!/bin/sh /etc/rc.common
# frpc init script for OpenWrt, instance "{{ item.name }}" (managed by Ansible)

START=99
STOP=10

USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/frpc -c /etc/frp/{{ item.name }}.toml
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/frp/{{ item.name }}.toml
    procd_close_instance
}
