    pat = re.compile(r"err|warn|fail|timeout|refus|handshake|amnezia|awg|dnsproxy|keen-pbr|easytier|netifd|pppd|l2tp|kernel:", re.I)
    lines = [ln for ln in execute(["logread"], 5)[1].splitlines() if "ansible-" not in ln and pat.search(ln)]
    print("\n".join(lines[-150:]))


# ---- delta: growth of the counters between two samples
def sample():
    d = collections.OrderedDict()
    for path in sorted(glob.glob("/sys/class/net/*")):
        name = os.path.basename(path)
        if name == "lo":
            continue
        for m in ("rx_bytes", "tx_bytes", "rx_dropped", "tx_dropped", "rx_errors", "tx_errors"):
            d[("if", name, m)] = num("%s/statistics/%s" % (path, m))
    for line in execute(["awg", "show", "all", "transfer"], 5)[1].splitlines():
        f = line.split("\t")
        if len(f) == 4:
            d[("awg", f[0], f[1][:8], "rx")] = int(f[2])
            d[("awg", f[0], f[1][:8], "tx")] = int(f[3])
    d[("g", "conntrack.count")] = num("/proc/sys/net/netfilter/nf_conntrack_count")
    d[("g", "conntrack.dns_flows")] = sum(1 for ln in read("/proc/net/nf_conntrack").splitlines() if "dport=53 " in ln)
    sn = [0, 0, 0]
    for line in read("/proc/net/softnet_stat").splitlines():
        for i, x in enumerate(line.split()[:3]):
            sn[i] += int(x, 16)
    for name, v in zip(("softnet.processed", "softnet.dropped", "softnet.time_squeeze"), sn):
        d[("c", name)] = v
    wanted = {"Tcp": ("RetransSegs", "OutRsts", "AttemptFails", "InErrs"),
              "Udp": ("InErrors", "RcvbufErrors", "SndbufErrors", "NoPorts")}
    names = {}
    for line in read("/proc/net/snmp").splitlines():
        f = line.split()
        proto = f[0].rstrip(":") if f else ""
        if proto not in wanted:
            continue
        if proto not in names:
            names[proto] = f[1:]
            continue
        for k, v in zip(names[proto], f[1:]):
            if k in wanted[proto]:
                d[("c", "snmp.%s.%s" % (proto, k))] = int(v)
    try:
        metrics = json.loads(execute(["ubus", "call", "dnsmasq", "metrics"], 3)[1])
        for k in ("dns_queries_forwarded", "dns_local_answered", "dns_unanswered", "dns_cache_inserted"):
            d[("c", "dnsmasq." + k)] = int(metrics.get(k, 0))
    except ValueError:
        pass
    return d


def v_delta():
    t1 = float(read("/proc/uptime").split()[0])
    a = sample()
    time.sleep(CFG["delta_seconds"])
    t2 = float(read("/proc/uptime").split()[0])
    b = sample()
    dt = max(t2 - t1, 0.001)
    print("== delta over %.1f s (growth since the first sample; the other views show totals since boot) ==" % dt)
    print("-- interfaces: bytes (B/s), dropped rx/tx, errors rx/tx --")
    for name in sorted({k[1] for k in b if k[0] == "if"}):
        g = lambda m: b[("if", name, m)] - a.get(("if", name, m), 0)  # noqa: E731
        print("%-16s rx %+d (%.0f B/s)  tx %+d (%.0f B/s)  drop %+d/%+d  err %+d/%+d" % (
            name, g("rx_bytes"), g("rx_bytes") / dt, g("tx_bytes"), g("tx_bytes") / dt,
            g("rx_dropped"), g("tx_dropped"), g("rx_errors"), g("tx_errors")))
    print("-- AWG peers (public key prefix) --")
    for iface, peer in sorted({k[1:3] for k in b if k[0] == "awg"}):
        rx = b[("awg", iface, peer, "rx")] - a.get(("awg", iface, peer, "rx"), 0)
        tx = b[("awg", iface, peer, "tx")] - a.get(("awg", iface, peer, "tx"), 0)
        print("%-16s peer %s  rx %+d (%.0f B/s)  tx %+d (%.0f B/s)%s" % (
            iface, peer, rx, rx / dt, tx, tx / dt, "   <-- no traffic" if rx == 0 and tx == 0 else ""))
    print("-- gauges (before -> after) --")
    for k in b:
        if k[0] == "g":
            print("%-28s %d -> %d (%+d)" % (k[1], a.get(k, 0), b[k], b[k] - a.get(k, 0)))
    print("-- counters (growth, per second) --")
    for k in b:
        if k[0] == "c":
            d = b[k] - a.get(k, 0)
            print("%-28s %+d (%.2f/s)" % (k[1], d, d / dt))


def v_tunnel_path():
    eps = awg_endpoints()
    if not eps:
        print("no AWG peer with an IPv4 endpoint")
        return
    header("ping x5 to every peer endpoint (the outer path, not through the tunnel)")
    icmp_ping(sorted({ip for _, ip, _ in eps}))
    for iface, ip, port in eps:
        header("%s: TCP to the endpoint %s" % (iface, ip))
        tcp_probes(["%s:%s" % (ip, port)] + ["%s:%s" % (ip, p) for p in CFG["tunnel_tcp_ports"]])
    header("control: TCP to %s (default route, independent of the tunnels)" % " ".join(CFG["control_tcp_targets"]))
    tcp_probes(CFG["control_tcp_targets"])


def v_mtu():
