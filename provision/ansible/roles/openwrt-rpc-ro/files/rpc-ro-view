    for iface, ip, _ in awg_endpoints():
        header("DF ping to the %s endpoint %s (outer path; size = IP packet bytes)" % (iface, ip))
        df_ping(ip, CFG["mtu_sizes"])
    for t in CFG["mtu_inner_targets"]:
        header("DF ping inside the tunnel to %s via %s (100 is the control: no reply means the target ignores ICMP)"
               % (t["host"], t["dev"]))
        df_ping(t["host"], CFG["mtu_sizes"], dev=t["dev"])


# ---- agh-stats: aggregates over AdGuardHome's query log (no API login needed)
RCODES = {0: "NOERROR", 1: "FORMERR", 2: "SERVFAIL", 3: "NXDOMAIN", 4: "NOTIMP", 5: "REFUSED"}


def tail_lines(path, n, block=1 << 20):
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        pos, data = f.tell(), b""
        while pos > 0 and data.count(b"\n") <= n:
            step = min(block, pos)
            pos -= step
            f.seek(pos)
            data = f.read(step) + data
    return data.splitlines()[-n:]


def rcode_of(answer_b64):
    try:
        return RCODES.get(base64.b64decode(answer_b64)[3] & 0x0F, "other")
    except (ValueError, IndexError):
        return "?"


def v_agh_stats():
    workdir = execute(["uci", "-q", "get", "adguardhome.config.workdir"], 3)[1].strip() or "/var/lib/adguardhome"
    path = os.path.join(workdir, "data", "querylog.json")
    if not os.path.exists(path):
        print("no AdGuardHome query log at %s" % path)
        return
    rows = []
    for line in tail_lines(path, CFG["agh_stats_entries"]):
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    if not rows:
        print("query log is empty")
        return
    header("window")
    print("entries: %d, from %s to %s" % (len(rows), rows[0].get("T"), rows[-1].get("T")))
    per_up = collections.defaultdict(lambda: {"n": 0, "ms": [], "rc": collections.Counter()})
    domains, clients, qtypes, rcs, noup = (collections.Counter() for _ in range(5))
    blocked = cached = 0
    for r in rows:
        up = r.get("Upstream") or ""
        rc = rcode_of(r["Answer"]) if r.get("Answer") else "no-answer"
        rcs[rc] += 1
        domains[r.get("QH", "?")] += 1
        clients[r.get("IP", "?")] += 1
        qtypes[r.get("QT", "?")] += 1
        cached += bool(r.get("Cached"))
        blocked += bool((r.get("Result") or {}).get("IsFiltered"))
        if not up:
            noup[rc] += 1
            continue
        d = per_up[up]
        d["n"] += 1
        d["rc"][rc] += 1
        if r.get("Elapsed"):
            d["ms"].append(r["Elapsed"] / 1e6)
    header("per upstream (queries, avg/p95/max ms, answers by rcode)")
    for up, d in sorted(per_up.items(), key=lambda kv: -kv[1]["n"]):
        ms = sorted(d["ms"])
        avg = sum(ms) / len(ms) if ms else 0
        p95 = ms[max(int(len(ms) * 0.95) - 1, 0)] if ms else 0
        print("%7d  %-52s avg %6.0f  p95 %6.0f  max %6.0f  %s" % (
            d["n"], up, avg, p95, ms[-1] if ms else 0, dict(d["rc"])))
    print("answered without an upstream (cache/blocked/local): %s" % dict(noup))
    header("overall")
    print("rcodes: %s" % dict(rcs))
    print("cached: %d, blocked by filters: %d" % (cached, blocked))
    print("query types: %s" % dict(qtypes.most_common(8)))
    header("top domains")
    for k, v in domains.most_common(15):
        print("%7d  %s" % (v, k))
    header("top clients")
    for k, v in clients.most_common(10):
        print("%7d  %s" % (v, k))


