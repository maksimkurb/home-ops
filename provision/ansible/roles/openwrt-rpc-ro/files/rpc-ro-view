RCODE_NAMES = {0: "NOERROR", 1: "FORMERR", 2: "SERVFAIL", 3: "NXDOMAIN", 4: "NOTIMP", 5: "REFUSED"}


def _skip_name(data, off):
    while True:
        n = data[off]
        if n == 0:
            return off + 1
        if n & 0xC0 == 0xC0:
            return off + 2
        off += n + 1


def dns_query(server, name, tcp=False, timeout=1.5, tries=2):
    """One A query -> {"rcode", "answers", "addrs", "ms"} or None when nothing came back.

    UDP is tried `tries` times, so one lost packet is not reported as an outage."""
    msg = struct.pack("!HHHHHH", random.randint(0, 65535), 0x0100, 1, 0, 0, 0)
    for label in name.rstrip(".").split("."):
        msg += bytes([len(label)]) + label.encode()
    msg += b"\0" + struct.pack("!HH", 1, 1)
    for _ in range(1 if tcp else tries):
        t0 = time.time()
        try:
            if tcp:
                with socket.create_connection((server, 53), timeout + 1) as c:
                    c.sendall(struct.pack("!H", len(msg)) + msg)
                    c.settimeout(timeout + 1)
                    raw = b""
                    while len(raw) < 2 or len(raw) < 2 + struct.unpack("!H", raw[:2])[0]:
                        chunk = c.recv(4096)
                        if not chunk:
                            break
                        raw += chunk
                data = raw[2:]
            else:
                with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as c:
                    c.settimeout(timeout)
                    c.sendto(msg, (server, 53))
                    data = c.recv(4096)
            if len(data) < 12:
                continue
        except OSError:
            continue
        ms = (time.time() - t0) * 1000
        qd, an = struct.unpack("!HH", data[4:8])
        off = 12
        for _ in range(qd):
            off = _skip_name(data, off) + 4
        addrs = []
        for _ in range(an):
            off = _skip_name(data, off)
            rtype, _cls, _ttl, rdlen = struct.unpack("!HHIH", data[off:off + 10])
            off += 10
            if rtype == 1 and rdlen == 4:
                addrs.append(socket.inet_ntoa(data[off:off + 4]))
            off += rdlen
        return {"rcode": RCODE_NAMES.get(data[3] & 0x0F, str(data[3] & 0x0F)), "answers": an, "addrs": addrs, "ms": ms}
    return None


def _fmt_dns(r):
    if r is None:
        return "no answer"
    return "%s, %d answers, %.0f ms" % (r["rcode"], r["answers"], r["ms"])


def _dns_good(r):
    return bool(r) and r["rcode"] == "NOERROR" and r["answers"] > 0


def v_dns_probe():
    domain, control = CFG["dns_probe_domain"], CFG["dns_probe_control_domain"]
    header("dns probe: %s (control: %s)" % (domain, control))

    def one(server):
        udp, tcp = dns_query(server, domain), dns_query(server, domain, tcp=True)
        ctl = dns_query(server, control)
        if udp is None and tcp is None:
            verdict = "NO ANSWER on udp or tcp"
        elif _dns_good(udp):
            verdict = "ok" if _dns_good(tcp) or tcp is None else "ok over udp, tcp/53 fails"
        elif _dns_good(tcp):
            verdict = ("UDP/53 answers are rewritten or dropped on the path (tcp/53 gives real answers)"
                       if udp else "udp/53 does not answer, tcp/53 does")
        elif udp is not None and udp["rcode"] == "NXDOMAIN":
            verdict = ("the name is filtered or does not exist for this resolver; the control name works, so it is not an outage"
                       if _dns_good(ctl) else "NXDOMAIN for both names: the resolver is broken")
        else:
            verdict = "no usable answer (%s)" % _fmt_dns(udp)
        return "%-16s %s udp: %s | tcp: %s | %s udp: %s  => %s" % (
            server, domain, _fmt_dns(udp), _fmt_dns(tcp), control, _fmt_dns(ctl), verdict)

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(len(CFG["dns_probe_servers"]), 1)) as ex:
        for line in ex.map(one, CFG["dns_probe_servers"]):
            print(line)


