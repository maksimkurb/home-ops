# ---------------------------------------------------------------- helpers
def read(path, default=""):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return default


def num(path):
    try:
        return int(read(path).strip())
    except ValueError:
        return 0


def execute(cmd, timeout=10):
    """Run cmd (a list) -> (returncode or None on timeout, stdout+stderr)."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, timeout=timeout, env=ENV)
        return p.returncode, p.stdout.decode(errors="replace")
    except subprocess.TimeoutExpired as e:
        return None, (e.stdout or b"").decode(errors="replace") + "\n(timed out after %ss)\n" % timeout
    except FileNotFoundError:
        return 127, "%s: not found\n" % cmd[0]


def show(cmd, timeout=10, limit=0, tail=False):
    _, text = execute(cmd, timeout)
    lines = text.splitlines()
    if limit:
        lines = lines[-limit:] if tail else lines[:limit]
    print("\n".join(lines))


def header(title):
    print("== %s ==" % title)


def have(tool):
    return shutil.which(tool, path=ENV["PATH"]) is not None


# ---------------------------------------------------------------- network probes
def checksum(data):
    if len(data) % 2:
        data += b"\0"
    s = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    s = (s >> 16) + (s & 0xFFFF)
    s += s >> 16
    return ~s & 0xFFFF


def echo_packet(ident, seq, size):
    body = bytes(max(size, 0))
    hdr = struct.pack("!BBHHH", 8, 0, 0, ident, seq)
    return struct.pack("!BBHHH", 8, 0, checksum(hdr + body), ident, seq) + body


def raw_socket(dev=None, df=False):
    s = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP)
    if df:
        s.setsockopt(socket.IPPROTO_IP, 10, 2)  # IP_MTU_DISCOVER = IP_PMTUDISC_DO
    if dev:
        s.setsockopt(socket.SOL_SOCKET, 25, dev.encode())  # SO_BINDTODEVICE
    return s


def icmp_ping(hosts, dev=None, count=5, interval=0.3, wait=2.0):
    """`count` echoes to every host at once. Prints loss and rtt per host."""
    ident = (os.getpid() + 1) & 0xFFFF
    s = raw_socket(dev)
    ips = [socket.gethostbyname(h) for h in hosts]
    sent, rtts = {}, {ip: [] for ip in ips}

    def collect():
        data, (src, _) = s.recvfrom(65535)
        ihl = (data[0] & 0x0F) * 4
        if data[ihl] == 0 and struct.unpack("!H", data[ihl + 4:ihl + 6])[0] == ident:
            seq = struct.unpack("!H", data[ihl + 6:ihl + 8])[0]
            t0 = sent.pop((src, seq), None)
            if t0 is not None:
                rtts[src].append((time.time() - t0) * 1000)

    def pump(seconds):
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([s], [], [], max(end - time.time(), 0))
            if r:
                collect()

    for k in range(count):
        for i, ip in enumerate(ips):
            seq = i * count + k + 1
            sent[(ip, seq)] = time.time()
            try:
                s.sendto(echo_packet(ident, seq, 56), (ip, 0))
            except OSError:
                pass
        pump(interval)
    pump(wait)
    s.close()
    for h, ip in zip(hosts, ips):
        got = rtts[ip]
        loss = 100 * (count - len(got)) // count
        rtt = ("rtt min/avg/max = %.1f/%.1f/%.1f ms" % (min(got), sum(got) / len(got), max(got))
               if got else "no replies")
        print("ping %-18s %d sent, %d received, %d%% loss, %s" % (h, count, len(got), loss, rtt))


def df_ping(host, sizes, dev=None, wait=2.0, tries=2):
    """DF-bit echoes of every size (bytes of IP packet) at once: finds the usable path MTU.

    Every size is sent `tries` times and a reply to any of them counts, so one lost packet
    is not reported as a PMTU black hole."""
    ident = os.getpid() & 0xFFFF
    s = raw_socket(dev, df=True)
    where = {}  # seq -> index of the size
    result, sent_at = {}, {}
    seq = 0
    for _ in range(tries):
        for idx, size in enumerate(sizes):
            seq += 1
            where[seq] = idx
            sent_at[seq] = time.time()
            try:
                s.sendto(echo_packet(ident, seq, size - 28), (host, 0))  # 20 IP + 8 ICMP
            except OSError:
                result.setdefault(idx, "too big for the local route MTU")
    deadline = time.time() + wait
    while time.time() < deadline and any(i not in result for i in range(len(sizes))):
        r, _, _ = select.select([s], [], [], max(deadline - time.time(), 0))
        if not r:
            break
        data, _ = s.recvfrom(65535)
        ihl = (data[0] & 0x0F) * 4
        kind, code = data[ihl], data[ihl + 1]
        if kind == 0 and struct.unpack("!H", data[ihl + 4:ihl + 6])[0] == ident:
            q = struct.unpack("!H", data[ihl + 6:ihl + 8])[0]
            if q in where:
                result[where[q]] = "ok, %.0f ms" % ((time.time() - sent_at[q]) * 1000)
        elif kind == 3 and code == 4:  # fragmentation needed; the original echo is quoted
            nh = struct.unpack("!H", data[ihl + 6:ihl + 8])[0]
            inner = data[ihl + 8:]
            iihl = (inner[0] & 0x0F) * 4
            if struct.unpack("!H", inner[iihl + 4:iihl + 6])[0] == ident:
                q = struct.unpack("!H", inner[iihl + 6:iihl + 8])[0]
                if q in where and not result.get(where[q], "").startswith("ok"):
                    result[where[q]] = "rejected: fragmentation needed, next-hop MTU %d" % nh
    s.close()
    passed = []
    for idx, size in enumerate(sizes):
        res = result.get(idx, "no reply (lost, or a PMTU black hole)")
        if res.startswith("ok"):
            passed.append(size)
        print("%s DF size=%-5d %s" % (host, size, res))
    print("%s largest DF size that passed: %s" % (host, max(passed) if passed else "none"))


def tcp_probe(target, timeout=3.0):
    host, _, port = target.rpartition(":")
    t0 = time.time()
    try:
        socket.create_connection((host, int(port)), timeout).close()
        res = "connected in %.0f ms" % ((time.time() - t0) * 1000)
    except socket.timeout:
        res = "timeout (no answer, or filtered)"
    except ConnectionRefusedError:
        res = "refused (the host answers, the port is closed)"
    except OSError as e:
        res = "error: %s" % e.strerror
    return "tcp %-24s %s" % (target, res)


def tcp_probes(targets):
    if not targets:
        return
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as ex:
        for line in ex.map(tcp_probe, targets):
            print(line)


def awg_endpoints():
    """AWG peers with an IPv4 endpoint -> [(interface, ip, port)], only on CFG["tunnel_ifaces"] if set.

    A hub terminates many client peers whose endpoints are dynamic and not worth probing;
    the interfaces to check are chosen per host (rpc_ro_tunnel_ifaces)."""
    out = []
    for line in execute(["awg", "show", "all", "endpoints"], 5)[1].splitlines():
        parts = line.split("\t")
        m = re.fullmatch(r"(\d+\.\d+\.\d+\.\d+):(\d+)", parts[-1]) if len(parts) == 3 else None
        if m and (not CFG["tunnel_ifaces"] or parts[0] in CFG["tunnel_ifaces"]):
            out.append((parts[0], m.group(1), m.group(2)))
    return out


# ---------------------------------------------------------------- redaction
SECRET_KEY = re.compile(r"password|passwd|token|secret|key|certificate_chain", re.I)


def redact_yaml(text):
    out, skip_indent = [], None
    for line in text.splitlines():
        indent = len(line) - len(line.lstrip(" "))
        if skip_indent is not None:
            if not line.strip() or indent > skip_indent:
                continue  # a block value (a PEM key, for example) belongs to the masked key
            skip_indent = None
        m = re.match(r"^(\s*(?:- )?)([A-Za-z_]+):", line)
        if m and SECRET_KEY.search(m.group(2)):
            out.append("%s%s: <redacted>" % (m.group(1), m.group(2)))
            skip_indent = indent
        else:
            out.append(line)
    return "\n".join(out)


def redact_json(node):
    if isinstance(node, dict):
        return {k: ("<redacted>" if SECRET_KEY.search(k) else redact_json(v)) for k, v in node.items()}
    if isinstance(node, list):
        return [redact_json(v) for v in node]
    return node


def redact_awg(text):
    out = []
    for line in text.splitlines():
        s = line.strip()
        if "key:" in s and not s.startswith("public key:"):
            out.append(line.split(":")[0] + ": <redacted>")  # private, preshared, header protection
        elif re.match(r"i[1-5]:", s):
            out.append(line.split(":")[0] + ": <cut>")  # long obfuscation blobs
        else:
            out.append(line)
    return "\n".join(out)


