# test-routing is the only view with arguments: the ACL allows `test-routing *`, so every
# argument is checked here and keen-pbr is started with an argument list, never a shell.
HOSTNAME = re.compile(r"^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9_-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9_-]{0,61}[A-Za-z0-9])?)*\.?$")


def _port(v):
    return v.isdigit() and 0 <= int(v) <= 65535


def _ip(v):
    try:
        ipaddress.ip_address(v)
        return True
    except ValueError:
        return False


TEST_ROUTING_OPTIONS = {
    "--proto": lambda v: v in ("tcp", "udp", "other"),
    "--src-addr": _ip,
    "--src-port": _port,
    "--dest-port": _port,
    "--dscp": lambda v: v.isdigit() and 0 <= int(v) <= 63,
}


def v_test_routing(args):
    usage = ("usage: rpc-ro-view test-routing <ip-or-domain> [--proto tcp|udp|other] [--src-addr IP] "
             "[--src-port N] [--dest-port N] [--dscp 0-63]")
    if not args:
        print(usage)
        return 2
    target, rest = args[0], args[1:]
    if not (_ip(target) or HOSTNAME.match(target)):
        print("invalid target %r: expected an IP address or a host name\n%s" % (target[:80], usage))
        return 2
    if len(rest) % 2:
        print("every option needs a value\n" + usage)
        return 2
    seen, cmd = set(), ["keen-pbr", "test-routing", target]
    for flag, value in zip(rest[0::2], rest[1::2]):
        check = TEST_ROUTING_OPTIONS.get(flag)
        if check is None or flag in seen or not check(value):
            print("invalid option %r %r\n%s" % (flag[:40], value[:40], usage))
            return 2
        seen.add(flag)
        cmd += [flag, value]
    show(cmd, 20, limit=120)
    return 0


