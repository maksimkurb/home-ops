ARG_VIEWS = {"test-routing": v_test_routing}


def on_alarm(signum, frame):
    print("\n(view stopped after %d s: rpcd would give up waiting)" % DEADLINE)
    sys.stdout.flush()
    os._exit(124)


def main(argv):
    names = sorted(VIEWS) + sorted(ARG_VIEWS)
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print("usage: rpc-ro-view {%s}" % "|".join(names))
        return 2
    if argv[1] == "--list":  # used by Ansible to compare with the ACL
        print("\n".join(names))
        return 0
    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(DEADLINE)
    name, args = argv[1], argv[2:]
    if name in ARG_VIEWS:
        return ARG_VIEWS[name](args) or 0
    if name in VIEWS:
        if args:
            print("the view %s takes no arguments" % name)
            return 2
        VIEWS[name]()
        return 0
    print("unknown view %r\nusage: rpc-ro-view {%s}" % (name[:40], "|".join(names)))
    return 2


if __name__ == "__main__":
    try:
        code = main(sys.argv)
        sys.stdout.flush()
        sys.exit(code)
    except BrokenPipeError:
        sys.exit(0)
