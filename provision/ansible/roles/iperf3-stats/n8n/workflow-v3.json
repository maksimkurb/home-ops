      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validate the webhook call and hand the raw body to iperf_ingest().\n// All parsing (iperf3 intervals, ttl hops, host lookup) lives in Postgres, so a\n// replayed call with the same x-idempotency-key is a no-op.\nconst { body, headers } = $input.item.json;\nconst key = headers['x-idempotency-key'];\nif (!key) {\n  throw new Error('x-idempotency-key header is required');\n}\nif (!body || typeof body !== 'object' || Array.isArray(body)) {\n  throw new Error('Webhook body must be a JSON object');\n}\nfor (const field of ['source_hostname', 'target_hostname', 'iperf_run_on_hostname']) {\n  if (!body[field]) throw new Error(`${field} is required`);\n}\nreturn { json: { idempotency_key: String(key), payload: body } };\n"
      }
    },
