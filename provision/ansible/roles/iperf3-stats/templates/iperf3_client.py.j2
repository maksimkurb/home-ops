"""
iperf3 Network Testing Client
Runs a traceroute (ttl), idle/loaded latency probes and bandwidth tests, and sends
the results to an n8n webhook.

Webhook calls of one invocation share `run_id`:
  test_type=trace     ttl traceroute: ICMP "path" pass + multi-flow "ecmp" pass
  test_type=download  iperf3 reverse test (server -> client)
  test_type=upload    iperf3 normal test (client -> server)
  test_type=icmp      --icmp-only runs (ping only, no iperf3)
"""

import argparse
import ctypes
import json
import math
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import uuid
from datetime import datetime
from typing import Optional, Dict, Any, List

try:
    import iperf3
except ImportError:
    print("ERROR: iperf3 Python library not installed. Install with: pip3 install iperf3")
    sys.exit(1)

try:
    import requests
except ImportError:
    print("ERROR: requests library not installed. Install with: pip3 install requests")
    sys.exit(1)


# Configuration from Ansible
WEBHOOK_URL = "{{ iperf3_client_webhook_url }}"
TEST_ATTEMPTS = {{ iperf3_client_test_attempts }}
WEBHOOK_ATTEMPTS = {{ iperf3_client_webhook_attempts }}
TEST_TIMEOUT = {{ iperf3_client_test_connect_timeout_sec }}
WEBHOOK_TIMEOUT = {{ iperf3_client_webhook_connect_timeout_sec }}
DEFAULT_OMIT = {{ iperf3_client_omit_sec }}
IDLE_PING_COUNT = {{ iperf3_client_idle_ping_count }}

TTL_BIN = "{{ iperf3_client_ttl_path }}"
TRACE_PATH_ROUNDS = {{ iperf3_client_trace_path_rounds }}
TRACE_ECMP_ROUNDS = {{ iperf3_client_trace_ecmp_rounds }}
TRACE_ECMP_FLOWS = {{ iperf3_client_trace_ecmp_flows }}
TRACE_ECMP_PROTOCOL = "{{ iperf3_client_trace_ecmp_protocol }}"
TRACE_ECMP_PORT = "{{ iperf3_client_trace_ecmp_port }}"
TRACE_INTERVAL = {{ iperf3_client_trace_interval_sec }}
TRACE_TIMEOUT = {{ iperf3_client_trace_timeout_sec }}
TRACE_MAX_TTL = {{ iperf3_client_trace_max_ttl }}

# Bumped when the payload shape changes; n8n/Postgres branch on it.
SCHEMA_VERSION = 2


def generate_idempotency_key() -> str:
    """Generate a unique idempotency key with microsecond precision"""
    return datetime.now().strftime('%Y%m%d%H%M%S%f')


# ============================================================================
# ping (idle / loaded latency)
# ============================================================================

def start_ping(host: str, count: int, bind_interface: Optional[str] = None) -> Optional[subprocess.Popen]:
    """Start ping in background (1 probe/sec, negligible load). Returns None if unavailable."""
    if not shutil.which("ping"):
        return None
    cmd = ["ping", "-c", str(count), "-W", "2"]
    if bind_interface:
        cmd += ["-I", bind_interface]
    cmd.append(host)
    try:
        return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    except Exception as e:
        print(f"  ⚠ Could not start ping: {e}")
        return None


def finish_ping(proc: Optional[subprocess.Popen], timeout: int) -> Optional[Dict[str, Any]]:
    """
    Wait for ping and compute stats from the per-reply RTTs, so jitter works with
    both iputils and BusyBox ping (BusyBox prints no mdev). Never raises.

    jitter_ms: mean absolute difference of consecutive RTTs (RFC 3550 style, unsmoothed)
    stddev_ms: population standard deviation of RTTs (iputils "mdev")
    """
    if proc is None:
        return None
    try:
        try:
            out, _ = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.terminate()
            out, _ = proc.communicate()
        loss = re.search(r"([0-9.]+)% packet loss", out)
        if not loss:
            return None
        sent = re.search(r"(\d+) packets transmitted", out)
        rtts = [float(m) for m in re.findall(r"time[=<]([0-9.]+) ?ms", out)]
        result: Dict[str, Any] = {"loss_pct": float(loss.group(1))}
        if sent:
            result["sent"] = int(sent.group(1))
        result["received"] = len(rtts)
        if rtts:
            avg = sum(rtts) / len(rtts)
            result.update(
                min_ms=round(min(rtts), 3),
                avg_ms=round(avg, 3),
                max_ms=round(max(rtts), 3),
                stddev_ms=round(math.sqrt(sum((r - avg) ** 2 for r in rtts) / len(rtts)), 3),
            )
            if len(rtts) > 1:
                diffs = [abs(b - a) for a, b in zip(rtts, rtts[1:])]
                result["jitter_ms"] = round(sum(diffs) / len(diffs), 3)
        return result
    except Exception as e:
        print(f"  ⚠ Ping failed: {e}")
        return None


# ============================================================================
# ttl traceroute
# ============================================================================

def start_ttl(host: str, mode: str, bind_interface: Optional[str] = None) -> Optional[subprocess.Popen]:
    """
    Start one ttl pass in background. mode:
      path - ICMP, one flow: per-hop loss/latency/jitter and destination detection
      ecmp - UDP/TCP with several source ports: load-balanced path discovery
    """
    if not os.access(TTL_BIN, os.X_OK):
        print(f"  ⚠ {TTL_BIN} not found, skipping {mode} trace")
        return None
    cmd = [
        TTL_BIN, host, "--json", "--no-update-check", "--no-geo", "--no-ix",
        "-i", str(TRACE_INTERVAL), "--timeout", str(TRACE_TIMEOUT), "-m", str(TRACE_MAX_TTL),
    ]
    if mode == "path":
        cmd += ["-p", "icmp", "-c", str(TRACE_PATH_ROUNDS)]
    else:
        cmd += ["-p", TRACE_ECMP_PROTOCOL, "--flows", str(TRACE_ECMP_FLOWS), "-c", str(TRACE_ECMP_ROUNDS)]
        if TRACE_ECMP_PORT:
            cmd += ["--port", str(TRACE_ECMP_PORT)]
    if bind_interface:
        cmd += ["--interface", bind_interface]
    env = dict(os.environ, DO_NOT_TRACK="1", TTL_NO_UPDATE_CHECK="1")
    try:
        return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
    except Exception as e:
        print(f"  ⚠ Could not start ttl ({mode}): {e}")
        return None


def finish_ttl(proc: Optional[subprocess.Popen], mode: str, timeout: int) -> Optional[Dict[str, Any]]:
    """Wait for a ttl pass and return its JSON session. Never raises."""
    if proc is None:
        return None
    try:
        try:
            out, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            out, err = proc.communicate()
            print(f"  ⚠ ttl ({mode}) timed out after {timeout}s")
            return None
        if proc.returncode != 0:
            print(f"  ⚠ ttl ({mode}) exited with {proc.returncode}: {err.strip()[:300]}")
            return None
        session = json.loads(out)
        return session[0] if isinstance(session, list) else session
    except Exception as e:
        print(f"  ⚠ ttl ({mode}) failed: {e}")
        return None


def _compact_responder(resp: Dict[str, Any]) -> Dict[str, Any]:
    # geo/ix are disabled; responder-level "sent" is always 0 (see ttl ResponderStats)
    return {k: v for k, v in resp.items() if k not in ("geo", "ix", "sent") and v is not None}


def compact_ttl(session: Optional[Dict[str, Any]], dest_ttl: Optional[int]) -> Optional[Dict[str, Any]]:
    """
    Shrink a ttl session for the webhook: drop the per-probe event log and the hops
    past the destination (ttl reports every TTL up to --max-ttl, and the destination
    answers all of them). dest_ttl falls back to the last responding hop.
    """
    if session is None:
        return None
    hops = session.get("hops") or []
    cutoff = dest_ttl or session.get("dest_ttl")
    if not cutoff:
        responding = [h["ttl"] for h in hops if h.get("received")]
        cutoff = max(responding) if responding else 0
    compact_hops = []
    for hop in hops:
        if hop["ttl"] > cutoff:
            break
        hop = dict(hop)
        hop["responders"] = {ip: _compact_responder(r) for ip, r in (hop.get("responders") or {}).items()}
        compact_hops.append(hop)
    result = {k: v for k, v in session.items() if k not in ("hops", "events")}
    result["hops"] = compact_hops
    return result


def start_trace(host: str, bind_interface: Optional[str]) -> Dict[str, Optional[subprocess.Popen]]:
    return {mode: start_ttl(host, mode, bind_interface) for mode in ("path", "ecmp")}


def finish_trace(procs: Dict[str, Optional[subprocess.Popen]]) -> Optional[Dict[str, Any]]:
    # rounds * interval + probe timeout, plus slack for rDNS/ASN lookups
    budget = int(max(TRACE_PATH_ROUNDS, TRACE_ECMP_ROUNDS) * TRACE_INTERVAL + TRACE_TIMEOUT) + 45
    path = finish_ttl(procs.get("path"), "path", budget)
    ecmp = finish_ttl(procs.get("ecmp"), "ecmp", budget)
    if path is None and ecmp is None:
        return None
    path_dest = path.get("dest_ttl") if path else None
    return {"path": compact_ttl(path, path_dest), "ecmp": compact_ttl(ecmp, path_dest)}


def summarize_trace(trace: Dict[str, Any]) -> str:
    path = trace.get("path") or {}
    hops = path.get("hops") or []
    dest = hops[-1] if hops else {}
    sent = (dest.get("received") or 0) + (dest.get("timeouts") or 0)
    loss = 100.0 * (dest.get("timeouts") or 0) / sent if sent else None
    ecmp_hops = sum(1 for h in (trace.get("ecmp") or {}).get("hops") or [] if len(h.get("responders") or {}) > 1)
    loss_txt = f"{loss:.0f}%" if loss is not None else "n/a"
    return f"{len(hops)} hops, reached={path.get('complete')}, dest loss={loss_txt}, ECMP hops={ecmp_hops}"


# ============================================================================
# iperf3
# ============================================================================

def run_iperf3_test(
    host: str,
    port: int,
    threads: int,
    duration: int,
    omit: int,
    reverse: bool = False,
    bind_interface: Optional[str] = None
) -> Optional[Dict[str, Any]]:
    """
    Run iperf3 test with retry logic

    Args:
        host: Target server hostname or IP
        port: Target server port
        threads: Number of parallel streams
        duration: Measured test duration in seconds
        omit: Seconds of slow-start excluded from the results (run before `duration`)
        reverse: If True, run in reverse mode (download), else upload
        bind_interface: Optional network interface to bind to

    Returns:
        Test results as dict, or None if all attempts failed
    """
    for attempt in range(1, TEST_ATTEMPTS + 1):
        try:
            print(f"  Attempt {attempt}/{TEST_ATTEMPTS}...")

            client = iperf3.Client()
            client.server_hostname = host
            client.port = port
            client.num_streams = threads
            client.duration = duration
            client.omit = omit
            client.zerocopy = True
            client.verbose = False
            client.reverse = reverse

            # Set timeout
            client.connect_timeout = TEST_TIMEOUT * 1000  # Convert to milliseconds

            # The iperf3 Python wrapper has no bind_dev property (assigning one is
            # a silent no-op), so call libiperf directly for SO_BINDTODEVICE.
            if bind_interface:
                client.lib.iperf_set_test_bind_dev.restype = None
                client.lib.iperf_set_test_bind_dev.argtypes = (ctypes.c_void_p, ctypes.c_char_p)
                client.lib.iperf_set_test_bind_dev(client._test, bind_interface.encode())

            # Run the test
            result = client.run()

            # Check if test was successful
            if result.error:
                print(f"  ✗ Test failed: {result.error}")
                if attempt < TEST_ATTEMPTS:
                    print(f"  Retrying in 2 seconds...")
                    time.sleep(2)
                continue

            # Receiver-side totals: for upload the sender-side numbers include data
            # still sitting in socket buffers and overstate the bitrate.
            print(f"  ✓ Test completed successfully")
            print(f"    Bitrate (receiver): {result.received_Mbps:.2f} Mbps")
            retransmits = getattr(result, 'retransmits', 0)
            if retransmits:
                print(f"    Retransmits: {retransmits}")

            # Return the raw JSON output from iperf3
            return result.json

        except Exception as e:
            print(f"  ✗ Exception during test: {e}")
            if attempt < TEST_ATTEMPTS:
                print(f"  Retrying in 2 seconds...")
                time.sleep(2)

    print(f"  ✗ All {TEST_ATTEMPTS} attempts failed")
    return None


# ============================================================================
# webhook
# ============================================================================

def check_kill_switch() -> bool:
    """
    Check kill-switch endpoint to see if tests should be aborted

    Returns:
        True if tests should be aborted (kill-switch returned non-200), False otherwise
    """
    if not WEBHOOK_URL:
        print("  ⚠ Webhook URL not configured, skipping kill-switch check")
        return False

    # Construct kill-switch URL
    kill_switch_url = WEBHOOK_URL.rstrip('/') + '/kill-switch'

    try:
        print(f"  Checking kill-switch...")

        response = requests.get(
            kill_switch_url,
            timeout=WEBHOOK_TIMEOUT
        )

        if response.status_code == 200:
            print(f"  ✓ Kill-switch returned 200 OK - proceeding with tests")
            return False
        else:
            print(f"  ⚠ Kill-switch returned HTTP {response.status_code} status, aborting tests")
            return True

    except requests.exceptions.Timeout:
        print(f"  ⚠ Kill-switch request timed out after {WEBHOOK_TIMEOUT}s - proceeding with tests")
        return False

    except requests.exceptions.RequestException as e:
        print(f"  ⚠ Kill-switch request failed: {e} - proceeding with tests")
        return False


def send_webhook(payload: Dict[str, Any], idempotency_key: str) -> bool:
    """
    Send results to n8n webhook with retry logic

    Args:
        payload: JSON payload to send
        idempotency_key: Unique key to prevent duplicate processing

    Returns:
        True if webhook was delivered successfully, False otherwise
    """
    if not WEBHOOK_URL:
        print("  ⚠ Webhook URL not configured, skipping webhook delivery")
        return True

    headers = {
        "Content-Type": "application/json",
        "x-idempotency-key": idempotency_key
    }

    for attempt in range(1, WEBHOOK_ATTEMPTS + 1):
        try:
            print(f"  Webhook attempt {attempt}/{WEBHOOK_ATTEMPTS}...")

            response = requests.post(
                WEBHOOK_URL,
                json=payload,
                headers=headers,
                timeout=WEBHOOK_TIMEOUT
            )

            # Check if request was successful (2xx status code)
            if 200 <= response.status_code < 300:
                print(f"  ✓ Webhook delivered successfully (HTTP {response.status_code})")
                print(f"    Response: {response.text[:200]}")
                print(f"    Idempotency key: {idempotency_key}")
                return True
            else:
                print(f"  ✗ Webhook failed with HTTP {response.status_code}")
                print(f"    Response: {response.text[:200]}")
                if attempt < WEBHOOK_ATTEMPTS:
                    print(f"  Retrying in 2 seconds...")
                    time.sleep(2)

        except requests.exceptions.Timeout:
            print(f"  ✗ Webhook request timed out after {WEBHOOK_TIMEOUT}s")
            if attempt < WEBHOOK_ATTEMPTS:
                print(f"  Retrying in 2 seconds...")
                time.sleep(2)

        except requests.exceptions.RequestException as e:
            print(f"  ✗ Webhook request failed: {e}")
            if attempt < WEBHOOK_ATTEMPTS:
                print(f"  Retrying in 2 seconds...")
                time.sleep(2)

    print(f"  ✗ Webhook delivery failed after {WEBHOOK_ATTEMPTS} attempts")
    return False


def base_payload(
    run_id: str,
    test_type: str,
    source_hostname: str,
    target_hostname: str,
    local_hostname: str,
    bind_interface: Optional[str]
) -> Dict[str, Any]:
    payload = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "test_type": test_type,
        "source_hostname": source_hostname,
        "target_hostname": target_hostname,
        "iperf_run_on_hostname": local_hostname,
        "timestamp": datetime.now().astimezone().isoformat(),
    }
    if bind_interface:
        payload["bind_interface"] = bind_interface
    return payload


def send_trace(
    run_id: str,
    target_host: str,
    local_hostname: str,
    bind_interface: Optional[str],
    trace: Optional[Dict[str, Any]]
) -> bool:
    if trace is None:
        print("✗ Trace failed (ttl unavailable or no output)")
        return False
    print(f"  Trace: {summarize_trace(trace)}")
    payload = base_payload(run_id, "trace", local_hostname, target_host, local_hostname, bind_interface)
    payload["trace"] = trace
    if send_webhook(payload, generate_idempotency_key()):
        print("✓ Trace sent")
        return True
    print("✗ Trace webhook delivery failed")
    return False


def run_test_and_send(
    run_id: str,
    target_host: str,
    port: int,
    threads: int,
    duration: int,
    omit: int,
    reverse: bool,
    local_hostname: str,
    bind_interface: Optional[str] = None,
    latency_idle: Optional[Dict[str, Any]] = None
) -> bool:
    """
    Run a single test and send results to webhook

    Returns:
        True if both test and webhook were successful, False otherwise
    """
    test_type = "download" if reverse else "upload"
    print(f"\nRunning {test_type} test ({omit}s omitted + {duration}s)...")

    # Generate idempotency key before test starts
    idempotency_key = generate_idempotency_key()

    # Ping alongside iperf3 to measure latency under load (bufferbloat)
    ping_proc = start_ping(target_host, omit + duration, bind_interface)
    result = run_iperf3_test(target_host, port, threads, duration, omit, reverse, bind_interface)
    latency_loaded = finish_ping(ping_proc, 5)

    if result is None:
        print(f"✗ {test_type} test failed")
        return False

    # Parse iperf3 JSON result
    try:
        result_data = json.loads(result) if isinstance(result, str) else result
    except (json.JSONDecodeError, TypeError):
        print(f"✗ Failed to parse iperf3 result")
        return False

    # In normal mode (upload) the client sends data, so it is the source;
    # in reverse mode (download) the server is.
    if reverse:
        source_hostname, target_hostname = target_host, local_hostname
    else:
        source_hostname, target_hostname = local_hostname, target_host

    # Merge the raw iperf3 JSON with metadata
    payload = {
        **result_data,
        **base_payload(run_id, test_type, source_hostname, target_hostname, local_hostname, bind_interface),
        "omit_sec": omit,
        "duration_sec": duration,
    }
    if latency_idle:
        payload["latency_idle"] = latency_idle
    if latency_loaded:
        payload["latency_loaded"] = latency_loaded

    if send_webhook(payload, idempotency_key):
        print(f"✓ {test_type} test completed and results sent")
        return True
    print(f"✗ {test_type} test completed but webhook delivery failed")
    return False


def run_icmp_only(
    run_id: str,
    target_host: str,
    count: int,
    local_hostname: str,
    bind_interface: Optional[str] = None,
    trace_enabled: bool = True
) -> bool:
    """
    Ping-only mode: measure latency/loss (and optionally trace the path) and send it
    to the webhook. The ping payload keeps the iperf3 shape with empty data.
    """
    print(f"\nRunning ICMP-only test ({count} probes)...")
    idempotency_key = generate_idempotency_key()

    trace_procs = start_trace(target_host, bind_interface) if trace_enabled else {}
    stats = finish_ping(start_ping(target_host, count, bind_interface), count * 2 + 5)
    trace_ok = True
    if trace_enabled:
        trace_ok = send_trace(run_id, target_host, local_hostname, bind_interface, finish_trace(trace_procs))

    if stats is None:
        print("✗ ICMP test failed (ping unavailable or no output)")
        return False
    print(f"  Result: {stats}")

    payload = {
        "intervals": [],
        "end": {},
        **base_payload(run_id, "icmp", local_hostname, target_host, local_hostname, bind_interface),
        "latency_idle": stats,
    }

    if send_webhook(payload, idempotency_key):
        print("✓ ICMP test completed and results sent")
        return trace_ok
    print("✗ ICMP test completed but webhook delivery failed")
    return False


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description='iperf3 Network Testing Client with n8n Webhook Integration'
    )
    parser.add_argument('--host', required=True, help='Target iperf3 server hostname or IP')
    parser.add_argument('--port', type=int, help='Target iperf3 server port')
    parser.add_argument('--threads', type=int, help='Number of parallel streams')
    parser.add_argument('--duration', type=int, help='Measured test duration in seconds, per direction')
    parser.add_argument('--omit', type=int, default=DEFAULT_OMIT,
                        help=f'Seconds of slow-start to drop before measuring (default: {DEFAULT_OMIT})')
    parser.add_argument('--bind-interface', help='Network interface to bind to (optional)')
    parser.add_argument('--client-hostname', help='Override client hostname (optional)')
    parser.add_argument('--icmp-only', action='store_true', help='Only ping the host (no iperf3); send latency stats to the webhook')
    parser.add_argument('--count', type=int, default=10, help='Number of ICMP probes in --icmp-only mode (default: 10)')
    parser.add_argument('--no-trace', dest='trace', action='store_false', help='Skip the ttl traceroute')

    args = parser.parse_args()
    if not args.icmp_only and None in (args.port, args.threads, args.duration):
        parser.error('--port, --threads and --duration are required unless --icmp-only is set')

    # Get local hostname
    if args.client_hostname:
        local_hostname = args.client_hostname
    else:
        try:
            local_hostname = socket.gethostname()
        except Exception:
            local_hostname = "unknown"

    run_id = str(uuid.uuid4())

    print("=" * 60)
    print("iperf3 Network Test")
    print("=" * 60)
    print(f"Run ID: {run_id}")
    print(f"Local hostname: {local_hostname}")
    if args.icmp_only:
        print(f"Target host (ICMP only): {args.host}")
    else:
        print(f"Target server: {args.host}:{args.port}")
        print(f"Threads: {args.threads}")
        print(f"Duration: {args.omit}s omitted + {args.duration}s per direction")
    if args.bind_interface:
        print(f"Bind interface: {args.bind_interface}")
    print(f"Trace: {'enabled' if args.trace else 'disabled'}")
    print(f"Webhook URL: {'configured' if WEBHOOK_URL else 'Not configured'}")
    print("=" * 60)

    # Check kill-switch before running tests
    print("\nChecking kill-switch...")
    if check_kill_switch():
        print("\n" + "=" * 60)
        print("Tests aborted due to kill-switch activation")
        print("=" * 60)
        sys.exit(0)

    if args.icmp_only:
        ok = run_icmp_only(run_id, args.host, args.count, local_hostname, args.bind_interface, args.trace)
        sys.exit(0 if ok else 1)

    # Idle phase: traceroute and idle latency in parallel, before any load
    print("\nMeasuring idle path...")
    trace_procs = start_trace(args.host, args.bind_interface) if args.trace else {}
    latency_idle = finish_ping(start_ping(args.host, IDLE_PING_COUNT, args.bind_interface), IDLE_PING_COUNT * 2 + 5)
    if latency_idle:
        print(f"  Idle latency: {latency_idle}")
    trace_success = True
    if args.trace:
        trace_success = send_trace(run_id, args.host, local_hostname, args.bind_interface, finish_trace(trace_procs))

    results = {}
    for reverse in (True, False):
        results["download" if reverse else "upload"] = run_test_and_send(
            run_id, args.host, args.port, args.threads, args.duration, args.omit, reverse,
            local_hostname, args.bind_interface, latency_idle
        )

    print("\n" + "=" * 60)
    print("Summary")
    print("=" * 60)
    if args.trace:
        print(f"Trace: {'✓ Success' if trace_success else '✗ Failed'}")
    for name, ok in results.items():
        print(f"{name.capitalize()} test: {'✓ Success' if ok else '✗ Failed'}")
    print("=" * 60)

    # Exit with error code if anything failed
    sys.exit(0 if trace_success and all(results.values()) else 1)


if __name__ == "__main__":
    main()
